---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HumanPresence from '../components/HumanPresence.astro';
import EmailForm from '../components/EmailForm.astro';

const discoveries = [
  { number: '01', title: 'The architecture of thought', text: '[Provisional copy] Observe the patterns that quietly shape perception, identity and choice.' },
  { number: '02', title: 'The intelligence of the heart', text: '[Provisional copy] Explore emotion as a living intelligence — neither command nor obstacle.' },
  { number: '03', title: 'The space of consciousness', text: '[Provisional copy] Discover the inner distance from which a different response can emerge.' },
];
---

<BaseLayout
  title="The Thought Revolution — RÉVÉLA"
  description="The first editorial experience from RÉVÉLA: a luminous inquiry into thought, consciousness and what is ready to emerge."
>
  <Header />
  <main id="top">
    <section class="hero celestial-section" aria-labelledby="hero-title">
      <div class="stars" aria-hidden="true"></div>
      <div class="light-ribbon ribbon-one" aria-hidden="true"></div>
      <div class="light-ribbon ribbon-two" aria-hidden="true"></div>
      <div class="hero-copy reveal">
        <p class="eyebrow"><span>A RÉVÉLA EDITION</span><span>01 — THOUGHT</span></p>
        <h1 id="hero-title">The Thought<br /><em>Revolution</em></h1>
        <p class="hero-intro">An invitation to meet the mind differently — and reveal the greater intelligence already alive within.</p>
        <div class="hero-actions">
          <a class="button button-light" href="#receive">Receive the preview <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#threshold">Enter the experience <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-visual reveal delay-one">
        <HumanPresence />
        <p class="visual-note note-mind">MIND <span>clarity</span></p>
        <p class="visual-note note-heart">HEART <span>intelligence</span></p>
      </div>
      <p class="hero-aside">A passage from thought<br />to conscious presence.</p>
      <div class="horizon" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>

    <section class="threshold light-section section-pad" id="threshold" aria-labelledby="threshold-title">
      <div class="section-index"><span>01</span><span>THE THRESHOLD</span></div>
      <div class="threshold-copy reveal">
        <p class="eyebrow dark">A book, and an opening</p>
        <h2 id="threshold-title">What if thought was not the end of the story, but the place where a larger one <em>begins?</em></h2>
      </div>
      <div class="threshold-foot reveal">
        <p>[Provisional editorial statement] The Thought Revolution creates a space between what has been inherited and what is ready to emerge. It is not an answer imposed from the outside, but an invitation to encounter the intelligence within.</p>
        <span class="manuscript">begin within</span>
      </div>
    </section>

    <section class="union section-pad" aria-labelledby="union-title">
      <div class="union-visual reveal">
        <HumanPresence variant="single" label="An androgynous human presence illuminated between mind and heart" />
        <div class="axis-label axis-top"><span>01</span> MENTAL</div>
        <div class="axis-label axis-bottom"><span>02</span> HEART</div>
      </div>
      <div class="union-copy reveal delay-one">
        <div class="section-index light"><span>02</span><span>THE INNER UNION</span></div>
        <h2 id="union-title">Clarity has a mind.<br /><em>Wisdom has a pulse.</em></h2>
        <p class="lead">RÉVÉLA begins where precision and sensitivity stop opposing one another.</p>
        <p>[Provisional copy] Thought gives language and structure. The heart gives depth and direction. Consciousness holds the space in which both can become something more.</p>
        <div class="formula" aria-label="Mind plus heart held by consciousness leads to emergence">
          <span>mind</span><b>+</b><span>heart</span><b>·</b><span>consciousness</span><b>→</b><span>emergence</span>
        </div>
      </div>
    </section>

    <section class="discoveries light-section section-pad" aria-labelledby="discoveries-title">
      <header class="discoveries-header reveal">
        <div class="section-index"><span>03</span><span>WITHIN THE EXPERIENCE</span></div>
        <h2 id="discoveries-title">Three movements<br />toward a wider self.</h2>
        <p class="placeholder-tag">Provisional chapter themes</p>
      </header>
      <div class="discovery-list">
        {discoveries.map((item) => (
          <article class="discovery reveal">
            <span class="discovery-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span class="arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section class="book section-pad" id="the-book" aria-labelledby="book-title">
      <div class="book-scene reveal" aria-label="Provisional cover of The Thought Revolution">
        <div class="book-horizon" aria-hidden="true"><span></span></div>
        <div class="book-orbit"></div>
        <div class="book-cover">
          <div class="cover-mark">RÉVÉLA</div>
          <div class="cover-sphere"></div>
          <p>The<br />Thought<br /><em>Revolution</em></p>
          <small>AN EDITORIAL EXPERIENCE<br />FINAL COVER TO COME</small>
        </div>
        <span class="cover-caption">PROVISIONAL ARTWORK — 01</span>
      </div>
      <div class="book-copy reveal delay-one">
        <div class="section-index light"><span>04</span><span>THE FIRST EDITION</span></div>
        <p class="eyebrow">The opening chapter of RÉVÉLA</p>
        <h2 id="book-title">A quiet revolution<br />in the way we <em>see.</em></h2>
        <p class="lead">The first editorial object from RÉVÉLA explores thought not as an enemy to silence, but as a doorway to understand.</p>
        <p>[Provisional book description] This space will hold the final synopsis, format, reading time and selected passage once the manuscript is ready.</p>
        <dl class="book-details">
          <div><dt>Format</dt><dd>Digital edition</dd></div>
          <div><dt>Language</dt><dd>English</dd></div>
          <div><dt>Release</dt><dd>To be revealed</dd></div>
        </dl>
        <a class="button button-light" href="#receive">Receive the first edition <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="revela light-section" id="revela" aria-labelledby="revela-title">
      <div class="revela-sky" aria-hidden="true">
        <div class="sun"></div><div class="mountain mountain-back"></div><div class="mountain mountain-front"></div>
      </div>
      <div class="revela-copy section-pad reveal">
        <div class="section-index"><span>05</span><span>THE LARGER UNIVERSE</span></div>
        <p class="eyebrow dark">Beyond the book</p>
        <h2 id="revela-title">RÉVÉLA is a space for what is already present — and ready to become <em>visible.</em></h2>
        <div class="manifesto-grid">
          <p>[Provisional manifesto] We explore the meeting point between identity, thought, emotion, body, intuition and consciousness.</p>
          <p>Not to repair the human being. Not to escape being human. To reveal, embody and express the life already moving within.</p>
        </div>
        <p class="future-line">BOOKS · LETTERS · AUDIO · EXPERIENCES <span>A larger constellation is forming.</span></p>
      </div>
    </section>

    <section class="signup celestial-section section-pad" id="receive" aria-label="Receive The Thought Revolution">
      <div class="signup-glow" aria-hidden="true"></div>
      <EmailForm />
    </section>
  </main>

  <footer>
    <a class="wordmark" href="#top">RÉVÉLA</a>
    <p>A contemporary editorial house<br />for human consciousness.</p>
    <div class="footer-links"><a href="mailto:hello@revela.world">Contact</a><span>Privacy · coming soon</span></div>
    <p class="copyright">© {new Date().getFullYear()} RÉVÉLA</p>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
  </script>
</BaseLayout>
