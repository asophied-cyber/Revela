---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import EditorialImage from '../components/EditorialImage.astro';
import EmailForm from '../components/EmailForm.astro';

const discoveries = [
  { number: '01', title: 'L’architecture de la pensée', text: '[Texte provisoire] Observer les schémas qui façonnent silencieusement la perception, l’identité et le choix.' },
  { number: '02', title: 'L’intelligence du cœur', text: '[Texte provisoire] Explorer l’émotion comme une intelligence vivante — ni ordre, ni obstacle.' },
  { number: '03', title: 'L’espace de la conscience', text: '[Texte provisoire] Découvrir la distance intérieure depuis laquelle une autre réponse peut émerger.' },
];
---

<BaseLayout
  title="The Thought Revolution — RÉVÉLA"
  description="La première expérience éditoriale de RÉVÉLA : une exploration lumineuse de la pensée, de la conscience et de ce qui est prêt à émerger."
>
  <Header />
  <main id="top">
    <section class="hero celestial-section" aria-labelledby="hero-title">
      <EditorialImage
        class="hero-image"
        src="/images/revela/hero-signature-desktop.svg"
        mobileSrc="/images/revela/hero-signature-mobile.svg"
        alt="Emplacement atmosphérique pour le futur portrait cinématographique de deux présences androgynes"
        loading="eager"
        priority={true}
        position="64% 45%"
      />
      <div class="image-scrim" aria-hidden="true"></div>
      <div class="stars" aria-hidden="true"></div>
      <div class="light-ribbon ribbon-one" aria-hidden="true"></div>
      <div class="light-ribbon ribbon-two" aria-hidden="true"></div>
      <div class="hero-copy reveal">
        <p class="eyebrow"><span>UNE ÉDITION RÉVÉLA</span><span>01 — PENSÉE</span></p>
        <h1 id="hero-title">The Thought<br /><em>Revolution</em></h1>
        <p class="hero-intro">Une invitation à rencontrer le mental autrement — et à révéler l’intelligence plus vaste déjà vivante en soi.</p>
        <div class="hero-actions">
          <a class="button button-light" href="#receive">Recevoir l’aperçu <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#threshold">Entrer dans l’expérience <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-focus reveal delay-one" aria-hidden="true">
        <span class="heart-light"></span>
        <span class="conscious-line"></span>
        <p class="visual-note note-mind">MENTAL <span>clarté</span></p>
        <p class="visual-note note-heart">CŒUR <span>intelligence</span></p>
      </div>
      <p class="hero-aside">Un passage de la pensée<br />à la présence consciente.</p>
      <div class="horizon" aria-hidden="true">
        <EditorialImage class="horizon-image" src="/images/revela/revela-horizon.svg" alt="" position="50% 58%" />
      </div>
    </section>

    <section class="threshold light-section section-pad" id="threshold" aria-labelledby="threshold-title">
      <div class="section-index"><span>01</span><span>LE SEUIL</span></div>
      <div class="threshold-copy reveal">
        <p class="eyebrow dark">Un livre, et une ouverture</p>
        <h2 id="threshold-title">Et si la pensée n’était pas la fin de l’histoire, mais le lieu où une histoire plus vaste <em>commence&nbsp;?</em></h2>
      </div>
      <div class="threshold-foot reveal">
        <p>[Texte éditorial provisoire] The Thought Revolution ouvre un espace entre ce qui a été hérité et ce qui est prêt à émerger. Non pas une réponse imposée de l’extérieur, mais une invitation à rencontrer l’intelligence intérieure.</p>
        <span class="manuscript">commencer en soi</span>
      </div>
    </section>

    <section class="union section-pad" aria-labelledby="union-title">
      <div class="union-visual reveal">
        <EditorialImage
          class="union-image"
          src="/images/revela/heart-mind.svg"
          alt="Emplacement atmosphérique pour la future photographie éditoriale du cœur et du mental"
          position="50% 42%"
        />
        <div class="union-light" aria-hidden="true"><span></span><span></span></div>
        <div class="axis-label axis-top"><span>01</span> MENTAL</div>
        <div class="axis-label axis-bottom"><span>02</span> CŒUR</div>
      </div>
      <div class="union-copy reveal delay-one">
        <div class="section-index light"><span>02</span><span>L’UNION INTÉRIEURE</span></div>
        <h2 id="union-title">La clarté a un esprit.<br /><em>La sagesse a un pouls.</em></h2>
        <p class="lead">RÉVÉLA commence là où précision et sensibilité cessent de s’opposer.</p>
        <p>[Texte provisoire] La pensée donne le langage et la structure. Le cœur offre la profondeur et la direction. La conscience contient l’espace dans lequel les deux peuvent devenir davantage.</p>
        <div class="formula" aria-label="Le mental et le cœur, reliés par la conscience, conduisent à l’émergence">
          <span>mental</span><b>+</b><span>cœur</span><b>·</b><span>conscience</span><b>→</b><span>émergence</span>
        </div>
      </div>
    </section>

    <section class="discoveries light-section section-pad" aria-labelledby="discoveries-title">
      <header class="discoveries-header reveal">
        <div class="section-index"><span>03</span><span>AU CŒUR DE L’EXPÉRIENCE</span></div>
        <h2 id="discoveries-title">Trois mouvements<br />vers un soi plus vaste.</h2>
        <p class="placeholder-tag">Thèmes de chapitres provisoires</p>
      </header>
      <div class="discoveries-visual reveal">
        <EditorialImage class="movements-image" src="/images/revela/three-movements.svg" alt="Emplacement panoramique pour la future photographie des trois mouvements" position="50% 52%" />
        <p><span>01 · ÉVEILLER</span><span>02 · EXPLORER</span><span>03 · RELIER</span></p>
      </div>
      <div class="discovery-list">
        {discoveries.map((item) => (
          <article class="discovery reveal">
            <span class="discovery-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span class="arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section class="book section-pad" id="the-book" aria-labelledby="book-title">
      <div class="book-scene reveal" aria-label="Couverture provisoire de The Thought Revolution">
        <EditorialImage class="book-atmosphere" src="/images/revela/revela-horizon.svg" alt="Paysage céleste provisoire derrière l’ebook" />
        <div class="book-horizon" aria-hidden="true"><span></span></div>
        <div class="book-orbit"></div>
        <div class="book-cover">
          <EditorialImage class="cover-art" src="/images/revela/thought-revolution-cover.svg" alt="Couverture provisoire de The Thought Revolution" />
        </div>
        <span class="cover-caption">VISUEL PROVISOIRE — 01</span>
      </div>
      <div class="book-copy reveal delay-one">
        <div class="section-index light"><span>04</span><span>LA PREMIÈRE ÉDITION</span></div>
        <p class="eyebrow">Le chapitre d’ouverture de RÉVÉLA</p>
        <h2 id="book-title">Une révolution silencieuse<br />dans notre manière de <em>voir.</em></h2>
        <p class="lead">Le premier objet éditorial de RÉVÉLA explore la pensée non comme un ennemi à faire taire, mais comme une porte vers la compréhension.</p>
        <p>[Description provisoire] Cet espace accueillera le synopsis final, le format, le temps de lecture et un passage choisi lorsque le manuscrit sera prêt.</p>
        <dl class="book-details">
          <div><dt>Format</dt><dd>Édition numérique</dd></div>
          <div><dt>Langue</dt><dd>À confirmer</dd></div>
          <div><dt>Parution</dt><dd>À révéler</dd></div>
        </dl>
        <a class="button button-light" href="#receive">Recevoir la première édition <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="revela light-section" id="revela" aria-labelledby="revela-title">
      <div class="revela-sky" aria-hidden="true">
        <EditorialImage class="world-image" src="/images/revela/revela-universe.svg" alt="" position="50% 55%" />
        <div class="sun"></div>
      </div>
      <div class="revela-copy section-pad reveal">
        <div class="section-index"><span>05</span><span>L’UNIVERS PLUS VASTE</span></div>
        <p class="eyebrow dark">Au-delà du livre</p>
        <h2 id="revela-title">RÉVÉLA est un espace pour ce qui est déjà présent — et prêt à devenir <em>visible.</em></h2>
        <div class="manifesto-grid">
          <p>[Manifeste provisoire] Nous explorons le point de rencontre entre identité, pensée, émotion, corps, intuition et conscience.</p>
          <p>Non pour réparer l’être humain. Non pour échapper à notre humanité. Pour révéler, incarner et exprimer la vie déjà en mouvement à l’intérieur.</p>
        </div>
        <p class="future-line">LIVRES · LETTRES · AUDIO · EXPÉRIENCES <span>Une constellation plus vaste prend forme.</span></p>
      </div>
    </section>

    <section class="signup celestial-section section-pad" id="receive" aria-label="Recevoir The Thought Revolution">
      <div class="signup-glow" aria-hidden="true"></div>
      <EmailForm />
    </section>
  </main>

  <footer>
    <a class="wordmark" href="#top">RÉVÉLA</a>
    <p>Une maison éditoriale contemporaine<br />pour la conscience humaine.</p>
    <div class="footer-links"><a href="mailto:hello@revela.world">Contact</a><span>Confidentialité · bientôt disponible</span></div>
    <p class="copyright">© {new Date().getFullYear()} RÉVÉLA</p>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
  </script>
</BaseLayout>
