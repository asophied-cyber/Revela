<header class="site-header" data-header>
  <a class="wordmark" href="#top" aria-label="RÉVÉLA — return to top">RÉVÉLA</a>
  <nav aria-label="Primary navigation">
    <a href="#the-book">The book</a>
    <a href="#revela">Our vision</a>
  </nav>
  <a class="header-cta" href="#receive">Receive the book</a>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 30;
    top: 0;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 1.4rem var(--page-gutter);
    color: var(--pearl);
    transition: padding 400ms ease, background 400ms ease, color 400ms ease, box-shadow 400ms ease;
  }

  .site-header.is-scrolled {
    padding-block: 0.9rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--pearl) 87%, transparent);
    box-shadow: 0 1px 0 rgba(51, 55, 89, 0.08);
    backdrop-filter: blur(18px);
  }

  .wordmark {
    width: fit-content;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.34em;
  }

  nav { display: flex; gap: clamp(1.4rem, 3vw, 3.4rem); }
  nav a, .header-cta { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; }
  nav a { opacity: 0.72; transition: opacity 200ms ease; }
  nav a:hover { opacity: 1; }
  .header-cta { justify-self: end; border-bottom: 1px solid currentColor; padding-bottom: 0.25rem; }

  @media (max-width: 720px) {
    .site-header { grid-template-columns: 1fr auto; }
    nav { display: none; }
    .header-cta { font-size: 0.6rem; }
  }
</style>
