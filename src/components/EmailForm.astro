<div class="form-shell" data-signup>
  <form class="signup-form" novalidate>
    <div class="form-copy">
      <p class="eyebrow">A first passage</p>
      <h2>Enter <em>The Thought Revolution</em></h2>
      <p class="intro">Receive the editorial preview and become part of the first RÉVÉLA circle.</p>
      <p class="placeholder-tag">Provisional invitation — final release details to come</p>
    </div>
    <div class="fields">
      <label for="email">Your email address</label>
      <div class="input-row">
        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        <button type="submit">
          <span class="button-label">Receive the preview</span>
          <span aria-hidden="true">↗</span>
        </button>
      </div>
      <p class="form-note">Demo only — your address will not be sent or stored.</p>
      <p class="form-error" role="alert" aria-live="polite"></p>
    </div>
  </form>

  <div class="success" hidden tabindex="-1">
    <span class="success-orbit" aria-hidden="true"></span>
    <p class="eyebrow">The doorway is open</p>
    <h2>You are part of the beginning.</h2>
    <p>In the final experience, your edition of <em>The Thought Revolution</em> will meet you here and in your inbox.</p>
    <a class="demo-download" href="#the-book" aria-disabled="true">Ebook access · available at launch</a>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-signup]');
  const form = root?.querySelector<HTMLFormElement>('form');
  const input = form?.querySelector<HTMLInputElement>('input[type="email"]');
  const error = form?.querySelector<HTMLElement>('.form-error');
  const button = form?.querySelector<HTMLButtonElement>('button');
  const success = root?.querySelector<HTMLElement>('.success');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input?.validity.valid) {
      if (error) error.textContent = 'Please enter a valid email address.';
      input?.focus();
      return;
    }

    if (error) error.textContent = '';
    if (button) {
      button.disabled = true;
      button.querySelector('.button-label')!.textContent = 'Opening…';
    }

    window.setTimeout(() => {
      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.focus();
      }
    }, 650);
  });
</script>

<style>
  .form-shell {
    position: relative;
    min-height: 31rem;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: var(--radius-large);
    background: linear-gradient(135deg, rgba(255,255,255,.1), rgba(189,193,235,.035));
    box-shadow: 0 2.5rem 7rem rgba(11, 15, 48, 0.22);
    overflow: hidden;
    backdrop-filter: blur(16px);
  }
  .form-shell::before {
    content: ''; position: absolute; width: 25rem; aspect-ratio: 1; right: -8rem; top: -12rem; border-radius: 50%;
    background: radial-gradient(circle, rgba(235, 181, 183, .35), transparent 66%); pointer-events: none;
  }
  .signup-form { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 8vw; align-items: end; min-height: 31rem; padding: clamp(2rem, 6vw, 5rem); }
  .form-copy { max-width: 34rem; }
  h2 { margin: 1.4rem 0 1.5rem; font: 400 clamp(2.6rem, 5vw, 5rem)/.98 var(--font-display); letter-spacing: -.04em; }
  h2 em { font-weight: 400; color: var(--peach); }
  .intro { max-width: 30rem; color: var(--mist); font-size: clamp(1rem, 1.25vw, 1.2rem); }
  .placeholder-tag { margin-top: 2rem; color: rgba(255,255,255,.5); font-size: .65rem; letter-spacing: .13em; text-transform: uppercase; }
  .fields { align-self: center; }
  label { display: block; margin-bottom: .8rem; color: var(--mist); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; }
  .input-row { display: flex; border-bottom: 1px solid rgba(255,255,255,.55); }
  input { width: 100%; min-width: 0; padding: 1rem 0; border: 0; color: white; background: transparent; outline: 0; font: 400 1rem var(--font-body); }
  input::placeholder { color: rgba(255,255,255,.45); }
  .input-row:focus-within { border-color: var(--peach); }
  button { display: flex; gap: 1rem; align-items: center; flex: none; border: 0; color: white; background: transparent; font: 500 .66rem var(--font-body); letter-spacing: .13em; text-transform: uppercase; cursor: pointer; }
  button:disabled { opacity: .5; cursor: wait; }
  .form-note, .form-error { min-height: 1.2rem; margin-top: .9rem; color: rgba(255,255,255,.45); font-size: .7rem; }
  .form-error { color: var(--rose); }
  .success { position: relative; display: grid; align-content: center; min-height: 31rem; padding: clamp(2rem, 8vw, 7rem); outline: none; }
  .success[hidden] { display: none; }
  .success h2, .success p { max-width: 43rem; }
  .success p { color: var(--mist); }
  .success-orbit { position: absolute; width: 20rem; aspect-ratio: 1; right: 4%; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; box-shadow: 0 0 6rem rgba(245,192,180,.15); }
  .demo-download { width: fit-content; margin-top: 2.3rem; padding-bottom: .45rem; border-bottom: 1px solid var(--peach); color: var(--peach); font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; }

  @media (max-width: 800px) {
    .signup-form { grid-template-columns: 1fr; gap: 3rem; align-content: center; }
  }
  @media (max-width: 520px) {
    .input-row { display: block; border: 0; }
    input { border-bottom: 1px solid rgba(255,255,255,.55); }
    button { margin-top: 1.4rem; padding: 1rem 0; }
  }
</style>
